{
  "name": "wordsnap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "security:sql": "node scripts/check-sql-injection-guard.mjs",
    "security:secrets": "node scripts/check-secrets-guard.mjs",
    "security:deps": "node scripts/check-deps-audit.mjs",
    "security:all": "npm run security:sql && npm run security:secrets && npm run security:deps",
    "security:observe": "node scripts/security-observe.mjs",
    "security:observe:ci": "node scripts/security-observe.mjs --ci",
    "security:observe:summary": "node scripts/security-observe-summary.mjs",
    "lint": "npm run security:sql && eslint",
    "lint:web": "eslint src shared next.config.ts postcss.config.mjs eslint.config.mjs scripts/check-deps-audit.mjs scripts/check-deps-audit.test.mjs scripts/check-secrets-guard.mjs scripts/check-secrets-guard.test.mjs scripts/check-sql-injection-guard.mjs scripts/check-sql-injection-guard.test.mjs scripts/security-observe.mjs scripts/security-observe-summary.mjs",
    "verify": "npm run lint:web && npm run security:all && npm test && npm run test:security && npm run build",
    "test:security:sql": "node --test scripts/check-sql-injection-guard.test.mjs",
    "test:security:secrets": "node --test scripts/check-secrets-guard.test.mjs",
    "test:security:deps": "node --test scripts/check-deps-audit.test.mjs",
    "test:security:routes": "tsx --test src/app/api/**/*.security.test.ts",
    "test:security": "npm run test:security:sql && npm run test:security:secrets && npm run test:security:deps && npm run test:security:routes",
    "qa:stripe:webhook-e2e": "tsx scripts/qa-stripe-webhook-e2e.ts",
    "audio:voice-quiz": "tsx scripts/generate-voice-quiz-audio.mjs",
    "audio:voice-quiz:check": "tsx scripts/check-voice-quiz-audio.mjs",
    "test": "npm run test:web",
    "test:web": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@apple/app-store-server-library": "^2.0.0",
    "@google/genai": "^1.44.0",
    "@sentry/nextjs": "^10.68.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.91.0",
    "apns2": "^12.2.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dexie": "^4.2.1",
    "framer-motion": "^12.29.0",
    "heic2any": "^0.0.4",
    "next": "^16.3.8",
    "openai": "^6.16.0",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-joyride": "^3.2.0",
    "stripe": "^22.0.0",
    "swapy": "^1.0.5",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@^5.0.0": "^5.0.12",
    "fast-uri": "^3.1.5",
    "form-data": "4.0.6",
    "minimatch": "^10.2.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "protobufjs": "7.6.3",
    "sharp": "^0.35.5",
    "undici": "7.30.0",
    "ws": "8.21.0"
  }
}
